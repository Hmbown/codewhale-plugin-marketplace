{
  "name": "codewhale-computer-use",
  "version": "0.11.2",
  "description": "Let Codewhale see and operate your apps.",
  "license": "MIT",
  "skills": "./skills/",
  "commands": "./commands/",
  "interface": {
    "displayName": "Codewhale Computer Use",
    "shortDescription": "Operate apps with text or vision",
    "developerName": "Codewhale"
  },
  "mcpServers": {
    "computer": {
      "command": "node",
      "args": [
        "mcp/server.mjs"
      ],
      "cwd": "./",
      "startupTimeoutMs": 30000,
      "toolTimeoutMs": 120000
    }
  }
}
