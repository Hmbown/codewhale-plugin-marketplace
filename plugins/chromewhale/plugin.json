{
  "$schema": "https://agent-plugins.org/schemas/plugin.json",
  "name": "chromewhale",
  "version": "0.1.0",
  "description": "Developer preview, loaded unpacked. Let Codewhale read and act on the Chrome tab you are looking at, in your own Chrome profile, one granted site at a time.",
  "author": {
    "name": "Codewhale"
  },
  "license": "MIT",
  "keywords": [
    "side-panel",
    "chrome-side-panel"
  ],
  "extensions": {
    "net.codewhale": {
      "display_name": "Chromewhale",
      "commands": {
        "path": "commands"
      },
      "skills": {
        "path": "skills"
      },
      "when": {
        "binaries": [
          "node"
        ],
        "os": [
          "macos",
          "linux",
          "windows"
        ]
      }
    }
  },
  "homepage": "https://github.com/Hmbown/codewhale-plugin-marketplace/tree/main/plugins/chromewhale",
  "repository": "https://github.com/Hmbown/codewhale-plugin-marketplace"
}
