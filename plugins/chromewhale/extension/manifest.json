{
  "manifest_version": 3,
  "name": "Codewhale for Chrome",
  "version": "0.2.0",
  "description": "Codewhale in Chrome. Chat with your local Codewhale runtime in a side panel and let it read and act on the tab you are looking at, one granted site at a time.",
  "minimum_chrome_version": "116",
  "icons": {
    "128": "media/icon.png"
  },
  "action": {
    "default_title": "Open Codewhale for Chrome",
    "default_icon": {
      "128": "media/icon.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "scripting", "storage", "tabs", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
